DATA_DIR=./data
HOST=127.0.0.1
PORT=8000
PUBLIC_ORIGIN=http://localhost:8000
COOKIE_SECURE=false
MAX_UPLOAD_MB=500
SESSION_DAYS=7
EMBEDDING_REPO=Xenova/multilingual-e5-small
EMBEDDING_FILE=onnx/model_quantized.onnx
SEARCH_MIN_SCORE=0.79
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
# Optional. OpenAI-compatible endpoint, server only. Without it, excerpts are clearly labelled.
LLM_BASE_URL=https://ai.starimg.ru/v1
LLM_API_KEY=
LLM_MODEL=claude-haiku-4-5
# Set for the one-time `python -m backend.cli create-admin` command. Never commit real values.
ADMIN_EMAIL=
ADMIN_PASSWORD=
