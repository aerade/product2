[Unit]
Description=Lectory HTTP API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=lectory
Group=lectory
WorkingDirectory=/opt/lectory/current
EnvironmentFile=/etc/lectory/lectory.env
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONUTF8=1
Environment=OMP_NUM_THREADS=2
ExecStart=/opt/lectory/current/.venv/bin/python -m uvicorn backend.app:app --host 127.0.0.1 --port 8102 --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/lectory
UMask=0077

[Install]
WantedBy=multi-user.target
